# =============================================================
# BarcutX — Backend API — Environment Variables
# Copy to .env and fill in your values
# =============================================================

# --- App ---
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","exp://localhost:8081"]

# --- Database ---
# For local Docker: postgresql+asyncpg://barcutx:barcutx_dev@localhost:5432/barcutx_dev
DATABASE_URL=postgresql+asyncpg://barcutx:barcutx_dev@localhost:5432/barcutx_dev

# --- Supabase ---
# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Redis ---
# Local Docker
REDIS_URL=redis://localhost:6379
# Upstash (production): rediss://default:password@your-endpoint.upstash.io:6380

# --- Stripe ---
# Use test keys (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PLATFORM_FEE_PERCENT=7

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
